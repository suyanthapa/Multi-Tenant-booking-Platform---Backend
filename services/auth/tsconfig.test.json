{
  "$schema": "https://json.schemastore.org/tsconfig.json",

  "extends": "./tsconfig.json",

  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["jest", "node"],
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },

  "include": ["**/*.test.ts", "**/*.ts"],

  "exclude": ["node_modules", "dist"]
}
