// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Business {
    id String @id @default(uuid())

    ownerId String @unique @map("owner_id") // vendor userId - one business per vendor

    name        String
    description String?
    type        BusinessType

    address Json
    phone   String?
    email   String

    status     BusinessStatus @default(PENDING)
    isVerified Boolean        @default(false) @map("is_verified")

    rejectionReasons RejectionReason[] @map("rejection_reasons")
    adminNotes       String?           @map("admin_notes")
    rejectedAt       DateTime?         @map("rejected_at")
    resubmitted      Boolean           @default(false)

    approvedAt DateTime? @map("approved_at")
    createdAt  DateTime  @default(now()) @map("created_at")
    updatedAt  DateTime  @updatedAt @map("updated_at")

    @@index([type])
    @@index([status])
    @@map("businesses")
}

enum BusinessType {
    HOTEL
    CLINIC
    SALON
    CO_WORKING
    OTHER
}

enum BusinessStatus {
    PENDING // Newly created, waiting for admin review
    ACTIVE // Live and bookable
    INACTIVE // Temporarily hidden by the owner
    SUSPENDED // Blocked by Admin
    DELETED // Soft-deleted
    REJECTED // Admin rejected the business during review
}

enum RejectionReason {
    INVALID_DOCUMENTS
    INCOMPLETE_PROFILE
    DUPLICATE_ACCOUNT
    PROHIBITED_CONTENT
    UNRESPONSIVE
    OTHER
}
